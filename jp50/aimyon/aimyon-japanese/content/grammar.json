  {
    "id": "g_te_form",
    "title": "て形",
    "surface_pattern": "動詞て形",
    "level": "beginner",
    "category": "morphology",
    "meaning_core": "作為連接動作與組合文法的基礎形式。",
    "meaning_extended": [
      "可接 ～ている、～てみる、～てほしい、～ていく、～てくる。"
    ],
    "formation_rules": [
      "う・つ・る→って。",
      "む・ぶ・ぬ→んで。",
      "く→いて；ぐ→いで；す→して。",
      "行く 是例外：行って。",
      "一段動詞去 る 加 て。"
    ],
    "prerequisites": ["g_masu"],
    "semantic_functions": ["connection", "prerequisite"],
    "register": "neutral",
    "usage_notes": ["錯在後接文法時，先檢查 て形是否正確。"],
